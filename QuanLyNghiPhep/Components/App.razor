@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="css/site.css?v=@CssVersion" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/app.js?v=@ScriptVersion"></script>
</body>
</html>
@code {
    private string ScriptVersion
    {
        get
        {
            try { return File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, "js", "app.js")).Ticks.ToString(); }
            catch { return "1"; }
        }
    }
    private string CssVersion
    {
        get
        {
            try { return File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, "css", "site.css")).Ticks.ToString(); }
            catch { return "1"; }
        }
    }
}

@page "/password"
@inject AppSession Session
<PageTitle>Đổi mật khẩu</PageTitle>
<main class="content" style="max-width:700px;margin:auto">
    <a href="/">← Trang chính</a>
    <h1>Đổi mật khẩu</h1>
    @if (!ready) { <p>Đang tải...</p> }
    else if (!Session.IsAuthenticated) { <p>Vui lòng đăng nhập để đổi mật khẩu.</p> }
    else
    {
        <p>Đổi mật khẩu cho @Session.UserName.</p>
        @if(Error is not null) { <p class="alert error">@(Error=="validation"?"Mật khẩu mới phải khác mật khẩu cũ, từ 8–256 ký tự và khớp xác nhận.":"Không thể đổi mật khẩu. Kiểm tra mật khẩu hiện tại và yêu cầu độ mạnh.")</p> }
        <form method="post" action="/account/change-password" data-enhance="false" class="panel form-body">
            <AntiforgeryToken />
            <div class="field"><label>Mật khẩu hiện tại</label><div class="password-input"><input name="current" type="password" required maxlength="256" autocomplete="current-password" /><button type="button" class="password-eye" aria-label="Hiện mật khẩu" title="Hiện mật khẩu" aria-pressed="false" onclick="leaveApp.togglePassword(this)"><Icon Name="eye" /></button></div></div>
            <div class="field"><label>Mật khẩu mới (ít nhất 8 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt)</label><div class="password-input"><input name="next" type="password" required minlength="@ValidationRules.PasswordMinLength" maxlength="256" autocomplete="new-password" /><button type="button" class="password-eye" aria-label="Hiện mật khẩu" title="Hiện mật khẩu" aria-pressed="false" onclick="leaveApp.togglePassword(this)"><Icon Name="eye" /></button></div></div>
            <div class="field"><label>Nhập lại mật khẩu mới</label><div class="password-input"><input name="confirm" type="password" required minlength="@ValidationRules.PasswordMinLength" maxlength="256" autocomplete="new-password" /><button type="button" class="password-eye" aria-label="Hiện mật khẩu" title="Hiện mật khẩu" aria-pressed="false" onclick="leaveApp.togglePassword(this)"><Icon Name="eye" /></button></div></div>
            <button class="btn primary" type="submit">Đổi mật khẩu</button>
        </form>
    }
</main>
@code {
    private bool ready;
    [SupplyParameterFromQuery(Name="error")] public string? Error {get;set;}
    protected override async Task OnInitializedAsync() {try {await Session.InitializeAsync();} catch(UserAccessException) {} ready=true;}
}

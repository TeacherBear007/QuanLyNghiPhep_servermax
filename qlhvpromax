# Workflow thay __QLHV_DOMAIN__ bằng tên miền cấu hình trên GitHub.
map $http_upgrade $qlhvpromax_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __QLHV_DOMAIN__;

    access_log /var/log/nginx/qlhvpromax.access.log;
    error_log /var/log/nginx/qlhvpromax.error.log;
    client_max_body_size 30m;

    # Thư mục include do bước deploy tạo trên server.
    include /etc/nginx/qlhvpromax/*.conf;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/qlhvpromax;
        try_files $uri =404;
    }

    location / {
        if ($scheme = http) {
            return 308 https://$host$request_uri;
        }

        proxy_pass http://127.0.0.1:10999;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $qlhvpromax_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
